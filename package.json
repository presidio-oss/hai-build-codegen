{
	"name": "hai-build-codegen-root",
	"private": true,
	"scripts": {
		"install:all": "cd apps/vscode && npm install && cd webview-ui && npm install",
		"dev": "cd apps/vscode && npm run dev",
		"compile": "cd apps/vscode && npm run compile",
		"package": "cd apps/vscode && npm run package",
		"build:webview": "cd apps/vscode && npm run build:webview",
		"dev:webview": "cd apps/vscode && npm run dev:webview",
		"lint": "cd apps/vscode && npm run lint",
		"check-types": "cd apps/vscode && npm run check-types",
		"test": "cd apps/vscode && npm run test",
		"clean:all": "cd apps/vscode && npm run clean:all",
		"protos": "cd apps/vscode && npm run protos",
		"storybook": "cd apps/vscode && npm run storybook",
		"publish:marketplace": "cd apps/vscode && npm run publish:marketplace",
		"vscode:prepublish": "cd apps/vscode && npm run vscode:prepublish",
		"changeset": "cd apps/vscode && npx changeset",
		"version-packages": "cd apps/vscode && npx changeset version"
	}
}
