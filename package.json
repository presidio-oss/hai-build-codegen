{
    "name": "@cline/packages",
    "private": true,
    "workspaces": [
        "sdk/packages/*",
        "apps/*",
        "!apps/vscode",
        "apps/cline-hub/src/webview",
        "apps/examples/*",
        "apps/examples/vscode/src/webview",
        "sdk/examples",
        "sdk/examples/plugins/*"
    ],
    "scripts": {
        "install:all": "cd apps/vscode && npm install && cd webview-ui && npm install",
        "compile": "cd apps/vscode && npm run compile",
        "package": "cd apps/vscode && npm run package",
        "build:webview": "cd apps/vscode && npm run build:webview",
        "dev:webview": "cd apps/vscode && npm run dev:webview",
        "check-types": "cd apps/vscode && npm run check-types",
        "clean:all": "cd apps/vscode && npm run clean:all",
        "protos": "cd apps/vscode && npm run protos",
        "storybook": "cd apps/vscode && npm run storybook",
        "publish:marketplace": "cd apps/vscode && npm run publish:marketplace",
        "publish:marketplace:prerelease": "cd apps/vscode && npm run publish:marketplace:prerelease",
        "vscode:prepublish": "cd apps/vscode && npm run vscode:prepublish",
        "changeset": "cd apps/vscode && npx changeset",
        "version-packages": "cd apps/vscode && npx changeset version",
        "ci:check-all": "cd apps/vscode && npm run check-types && npm run lint",
        "ci:build": "cd apps/vscode && npm run ci:build",
        "download-ripgrep": "cd apps/vscode && npm run download-ripgrep",
        "compile-standalone": "cd apps/vscode && npm run compile-standalone",
        "test:coverage": "cd apps/vscode && npm run test:coverage",
        "test:integration": "cd apps/vscode && npm run test:integration",
        "test:tp-orchestrator": "cd apps/vscode && npm run test:tp-orchestrator",
        "vscode:dev": "cd apps/vscode && npm run dev",
        "vscode:lint": "cd apps/vscode && npm run lint",
        "vscode:test": "cd apps/vscode && npm run test",
        "vscode:test:unit": "cd apps/vscode && npm run test:unit",
        "prepare": "husky",
        "build": "bun run clean && bun install && bun run build:sdk && bun -F @cline/cli build",
        "build:sdk": "bun --production -F './sdk/packages/*' build",
        "build:apps": "bun -F './apps/**' --production build",
        "build:models": "bun -F @cline/llms generate:models && bun format --write",
        "dev": "bun --conditions=development run build:sdk && bun run cli && bun run cli hub stop",
        "cli": "bun --conditions=development --cwd apps/cli dev",
        "code": "bun --conditions=development -F @cline/code dev",
        "clean": "bun run sdk/scripts/clean.ts",
        "types": "bun --parallel -F '*' typecheck",
        "test": "bun --parallel -F './sdk/packages/**' test; cd apps/vscode && npm run test",
        "test:unit": "bash -lc 'set -euo pipefail; bun -F @cline/agents test & p1=$!; bun -F @cline/llms test & p2=$!; bun -F @cline/core test:unit & p3=$!; wait $p1; wait $p2; wait $p3'",
        "test:e2e": "bun -F @cline/core test:e2e && bun -F @cline/cli test:e2e",
        "test:e2e:interactive": "bun -F @cline/cli test:e2e:interactive",
        "verify:routines": "zsh -lc 'cd sdk/packages/core && bunx vitest run src/cron/schedule-service.test.ts --config vitest.config.ts'",
        "verify:workos-device-auth": "bun sdk/scripts/verify-workos-device-auth.ts",
        "biome": "bunx --bun @biomejs/biome",
        "format": "bun biome format sdk/ apps/cli/ apps/cline-hub/ apps/examples/",
        "lint": "bun biome lint sdk/ apps/cli/ apps/cline-hub/ apps/examples/",
        "fix": "bun biome check --write --unsafe --diagnostic-level=error sdk/ apps/cli/ apps/cline-hub/ apps/examples/",
        "check": "bun biome check --diagnostic-level=error sdk/ apps/cli/ apps/cline-hub/ apps/examples/ && bun run build:sdk && bun run -F @cline/cli build && bun -F @cline/cline-hub build:webview && bun --parallel -F './sdk/packages/**' -F @cline/cli -F @cline/cline-hub typecheck && bun sdk/scripts/check-publish.ts",
        "version": "bun run types && bun sdk/scripts/version.ts",
        "release": "bun sdk/scripts/release.ts"
    },
    "lint-staged": {
        "sdk/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ],
        "apps/{cli,cline-hub,examples}/**": [
            "sh -c 'bun run types'",
            "bun biome check --no-errors-on-unmatched --files-ignore-unknown=true"
        ]
    },
    "module": "index.ts",
    "type": "module",
    "engines": {
        "bun": "1.4.2",
        "node": ">=22"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.5",
        "@types/bun": "^1.4.2",
        "@types/node": "^25.3.5",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "vitest": "^4.0.18"
    },
    "peerDependencies": {
        "nanoid": "^5.1.7",
        "typescript": "^5.9.3"
    },
    "overrides": {
        "axios": "1.18.0",
        "fast-uri": ">=3.1.4",
        "undici": ">=7.29.0 <8",
        "@opentui/core": "0.4.3",
        "@opentui/react": "0.4.3",
        "tar-fs": ">=3.1.1",
        "tar": "^7.5.2",
        "js-yaml": ">=4.3.2 <5",
        "serialize-javascript": ">=7.0.3",
        "protobufjs": "7.6.5",
        "mermaid": "11.16.1",
        "diff": "8.0.4",
        "@sap-cloud-sdk/connectivity": "4.9.1",
        "@sap-cloud-sdk/http-client": "4.9.1",
        "@sap-cloud-sdk/openapi": "4.9.1",
        "@sap-cloud-sdk/resilience": "4.9.1",
        "@sap-cloud-sdk/util": "4.9.1"
    },
    "trustedDependencies": [
        "better-sqlite3",
        "grpc-tools"
    ],
    "packageManager": "bun@1.4.2",
    "patchedDependencies": {
        "@opentui-ui/dialog@0.1.2": "patches/@opentui-ui%2Fdialog@0.1.2.patch",
        "ollama-ai-provider-v2@4.0.1": "patches/ollama-ai-provider-v2@4.0.1.patch"
    }
}
