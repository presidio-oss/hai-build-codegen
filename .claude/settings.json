{
  "permissions": {
    "allow": [
      "Bash(git ls-tree *)",
      "Bash(python3 -c ' *)",
      "Bash(git grep *)",
      "Bash(python3)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/claude-code-for-web-setup.sh"
          }
        ]
      }
    ]
  }
}
