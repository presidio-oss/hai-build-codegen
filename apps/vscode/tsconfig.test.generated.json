{
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"module": "commonjs",
		"moduleResolution": "node",
		"baseUrl": ".",
		"paths": {
			"@/*": [
				"./src/*"
			],
			"@api/*": [
				"./src/core/api/*"
			],
			"@core/*": [
				"./src/core/*"
			],
			"@generated/*": [
				"./src/generated/*"
			],
			"@hosts/*": [
				"./src/hosts/*"
			],
			"@integrations/*": [
				"./src/integrations/*"
			],
			"@packages/*": [
				"./src/packages/*"
			],
			"@services/*": [
				"./src/services/*"
			],
			"@shared/*": [
				"./src/shared/*"
			],
			"@utils/*": [
				"./src/utils/*"
			],
			"@cline/shared/*": [
				"./node_modules/@cline/shared/dist/*"
			]
		},
		"types": [
			"node",
			"bun",
			"mocha",
			"should",
			"vscode",
			"chai"
		],
		"typeRoots": [
			"./node_modules/@types",
			"../../node_modules/@types",
			"./src/types",
			"./src/test/types"
		],
		"outDir": "out",
		"rootDir": "."
	},
